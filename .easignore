# When this file exists, EAS Build uses it INSTEAD of .gitignore.
# Keep it in sync with .gitignore, plus the entries below.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

.vercel

# Backend is deployed to Vercel separately; the mobile bundle never needs it.
# Skipping it keeps the build archive small and stops backend deps being uploaded.
backend/
