{
  "expo": {
    "owner": "naitkomahli",
    "name": "SpendScan",
    "slug": "SpendScan",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.naitkomahli.spendscan",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F6B4F"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#2F6B4F"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "4c15927d-640a-4ac9-a3ed-0b55bceda72d"
      }
    }
  }
}
